# ==========================================================================
# THE LIVING LAW — Environment Variables
# Copy this file to ".env" and fill in your Web3Forms access keys.
# Get a free key per inbox at https://web3forms.com (confirm email first).
#
# Each form posts to its own inbox:
#   appointments@thelivinglaw.in  -> consultations / bookings
#   enquiry@thelivinglaw.in       -> product / kit enquiries
#   joinus@thelivinglaw.in        -> newsletter ("Join the Movement")
#   healthyrhythm@thelivinglaw.in -> 30-day challenge sign-ups
# ==========================================================================

VITE_W3F_KEY_APPOINTMENTS=REPLACE_ME_APPOINTMENTS_KEY
VITE_W3F_KEY_PRODUCTS=REPLACE_ME_PRODUCTS_KEY
VITE_W3F_KEY_NEWSLETTER=REPLACE_ME_NEWSLETTER_KEY
VITE_W3F_KEY_CHALLENGE=REPLACE_ME_CHALLENGE_KEY

# Public contact / display emails (shown nowhere by default; available to code)
VITE_EMAIL_APPOINTMENTS=appointments@thelivinglaw.in
VITE_EMAIL_PRODUCTS=enquiry@thelivinglaw.in
VITE_EMAIL_NEWSLETTER=joinus@thelivinglaw.in
VITE_EMAIL_CHALLENGE=healthyrhythm@thelivinglaw.in
